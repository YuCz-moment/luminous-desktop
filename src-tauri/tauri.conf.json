{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luminous",
  "version": "0.1.3",
  "identifier": "com.luminous.desktop",
  "build": {
    "beforeDevCommand": "node server.js",
    "devUrl": "http://localhost:4521",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "Luminous",
        "label": "main",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": [
      "../server.js",
      "../public"
    ]
  }
}
